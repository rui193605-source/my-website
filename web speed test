<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        background: #05070a;
        color: #e8edf2;
        font-family:
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            "Microsoft YaHei",
            sans-serif;
        overflow-x: hidden;
    }

    /* =========================背景网格========================= */

    body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.16;

        background-image:
            linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);

        background-size: 45px 45px;

        mask-image: linear-gradient(
            to bottom,
            black,
            transparent 85%
        );

        -webkit-mask-image: linear-gradient(
            to bottom,
            black,
            transparent 85%
        );
    }

    /* =========================顶部导航========================= */

    nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;

        height: 70px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 0 7%;

        background: rgba(5,7,10,0.72);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);

        border-bottom: 1px solid rgba(255,255,255,0.08);

        z-index: 10;
    }

    .logo {
        font-weight: 800;
        letter-spacing: 4px;
        font-size: 18px;
    }

    .logo span {
        opacity: 0.45;
    }

    nav a {
        color: #aeb8c2;
        text-decoration: none;
        margin-left: 28px;
        font-size: 13px;
        letter-spacing: 1px;
        transition: 0.25s;
    }

    nav a:hover {
        color: white;
    }

    /* =========================主区域========================= */

    .hero {
        min-height: 100vh;

        display: flex;
        align-items: center;

        padding: 100px 8% 60px;

        position: relative;
    }

    .hero-content {
        max-width: 850px;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 9px;

        padding: 8px 13px;

        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 999px;

        background: rgba(255,255,255,0.035);

        color: #9ca7b2;

        font-size: 12px;
        letter-spacing: 1px;
    }

    .status-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #6cff9b;

        box-shadow:
            0 0 10px #6cff9b;

        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0%,100% {
            opacity: 0.45;
        }

        50% {
            opacity: 1;
        }
    }

    h1 {
        margin: 25px 0 10px;

        font-size: clamp(60px, 11vw, 150px);

        line-height: 0.9;

        letter-spacing: -7px;

        font-weight: 900;

        background: linear-gradient(
            120deg,
            #ffffff,
            #9aa6b2
        );

        -webkit-background-clip: text;
        background-clip: text;

        color: transparent;
    }

    .subtitle {
        font-size: clamp(18px, 2.2vw, 28px);

        color: #9da8b3;

        margin-top: 30px;
    }

    .terminal {
        margin-top: 38px;

        display: inline-block;

        padding: 18px 22px;

        border-left: 2px solid #6cff9b;

        background: rgba(255,255,255,0.035);

        color: #89949f;

        font-family: monospace;

        font-size: 14px;

        box-shadow:
            0 0 30px rgba(108,255,155,0.04);
    }

    .terminal strong {
        color: #6cff9b;
    }

    /* =========================鼠标光晕========================= */

    .glow {
        position: fixed;

        width: 500px;
        height: 500px;

        border-radius: 50%;

        pointer-events: none;

        background:
            radial-gradient(
                circle,
                rgba(120,150,255,0.10),
                transparent 65%
            );

        transform: translate(-50%, -50%);

        z-index: -1;
    }

    /* =========================内容========================= */

    section {
        padding: 110px 8%;

        max-width: 1200px;

        margin: auto;
    }

    .section-label {
        color: #6cff9b;

        font-family: monospace;

        font-size: 15px;

        letter-spacing: 3px;

        margin-bottom: 15px;
    }

    h2 {
        font-size: 42px;

        margin: 0 0 45px;

        letter-spacing: -1px;
    }

    /* =========================测速面板========================= */

    .speed-panel {
        width: 100%;

        border: 1px solid rgba(255,255,255,0.10);

        background: rgba(255,255,255,0.025);

        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);

        padding: 32px;

        box-shadow:
            0 0 40px rgba(0,0,0,0.25);
    }

    .speed-grid {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 20px;
    }

    .speed-card {
        border: 1px solid rgba(255,255,255,0.08);

        background: rgba(255,255,255,0.025);

        padding: 28px;

        min-height: 230px;

        display: flex;

        flex-direction: column;

        justify-content: space-between;
    }

    .speed-card-label {
        font-family: monospace;

        font-size: 13px;

        letter-spacing: 3px;

        color: #8e99a4;
    }

    .speed-value {
        margin-top: 20px;

        font-size: clamp(42px, 6vw, 72px);

        line-height: 1;

        font-weight: 800;

        letter-spacing: -3px;

        color: #ffffff;
    }

    .speed-unit {
        font-family: monospace;

        font-size: 13px;

        color: #6cff9b;

        letter-spacing: 2px;

        margin-top: 10px;
    }

    .speed-progress {
        width: 100%;

        height: 3px;

        background: rgba(255,255,255,0.08);

        margin: 25px 0 20px;

        overflow: hidden;
    }

    .speed-progress-bar {
        width: 0%;

        height: 100%;

        background: #6cff9b;

        box-shadow:
            0 0 12px rgba(108,255,155,0.6);

        transition: width 0.2s linear;
    }

    .speed-button {
        width: 100%;

        padding: 13px 16px;

        border: 1px solid rgba(255,255,255,0.14);

        background: rgba(255,255,255,0.045);

        color: #dce3e9;

        font-family: monospace;

        font-size: 12px;

        letter-spacing: 2px;

        cursor: pointer;

        transition: 0.25s;
    }

    .speed-button:hover {
        border-color: #6cff9b;

        color: #6cff9b;

        background: rgba(108,255,155,0.05);
    }

    .speed-button:disabled {
        cursor: not-allowed;

        opacity: 0.6;
    }

    /* =========================网络信息========================= */

    .network-info {
        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 20px;

        margin-top: 20px;
    }

    .info-card {
        border-top: 1px solid rgba(255,255,255,0.10);

        padding: 22px 5px 5px;
    }

    .info-label {
        font-family: monospace;

        font-size: 11px;

        letter-spacing: 2px;

        color: #7f8a95;
    }

    .info-value {
        margin-top: 9px;

        font-family: monospace;

        font-size: 24px;

        color: #ffffff;
    }

    .info-unit {
        font-size: 11px;

        color: #6cff9b;

        margin-left: 4px;
    }

    .speed-status {
        margin-top: 25px;

        font-family: monospace;

        font-size: 12px;

        color: #7f8a95;

        min-height: 18px;
    }

    /* =========================关于========================= */

    .about {
        max-width: 760px;

        color: #89949e;

        font-size: 17px;

        line-height: 2;
    }

    .highlight {
        color: white;
    }

    /* =========================页脚========================= */

    footer {
        padding: 80px 8% 40px;

        color: #ffffff;

        font-family: monospace;

        font-size: 17px;

        font-weight: 700;

        display: flex;

        justify-content: space-between;

        border-top:
            1px solid rgb(255, 255, 255);
    }

    /* =========================手机端========================= */

    @media (max-width: 700px) {

        nav {
            padding: 0 5%;
        }

        nav a {
            margin-left: 12px;

            font-size: 11px;
        }

        .hero {
            min-height: auto;

            padding-top: 100px;

            padding-left: 6%;
            padding-right: 6%;

            padding-bottom: 100px;
        }

        h1 {
            letter-spacing: -4px;
        }

        section {
            padding-left: 6%;
            padding-right: 6%;
        }

        h2 {
            font-size: 34px;
        }

        .speed-panel {
            padding: 18px;
        }

        .speed-grid {
            grid-template-columns: 1fr;
        }

        .network-info {
            grid-template-columns: 1fr;
        }

        footer {
            flex-direction: column;

            gap: 15px;
        }
    }

    /* =========================小屏手机========================= */

    @media (max-width: 420px) {

        nav .logo {
            font-size: 15px;

            letter-spacing: 3px;
        }

        nav a {
            margin-left: 8px;

            font-size: 9px;

            letter-spacing: 0.5px;
        }

        .hero {
            padding-left: 5%;
            padding-right: 5%;
        }

        h1 {
            font-size: clamp(55px, 20vw, 90px);
        }

        .speed-panel {
            padding: 14px;
        }

        .speed-card {
            padding: 20px;
        }

        .speed-value {
            font-size: 46px;
        }
    }
</style>
</head>


<body>

<!-- =========================鼠标光晕========================= -->

<div class="glow" id="glow"></div>


<!-- =========================顶部导航========================= -->

<nav>

    <div class="logo">
        JERRY<span> / 2026</span>
    </div>

    <div>
        <a href="index.html">返回</a>
    </div>

</nav>


<!-- =========================测速区域========================= -->

<section>

    <div class="section-label">
        NETWORK DIAGNOSTICS
    </div>

    <h2>
        Internet Speed Test
    </h2>


    <div class="speed-panel">

        <div class="speed-grid">

            <!-- =========================下载========================= -->

            <div class="speed-card">

                <div>

                    <div class="speed-card-label">
                        开始
                    </div>

                    <div class="speed-value"
                         id="downloadValue">
                        --
                    </div>

                    <div class="speed-unit">
                        Mbps
                    </div>

                </div>


                <div>

                    <div class="speed-progress">

                        <div
                            class="speed-progress-bar"
                            id="downloadProgress">
                        </div>

                    </div>

                    <button
                        class="speed-button"
                        id="downloadButton"
                        onclick="testDownload()">

                        TEST DOWNLOAD

                    </button>

                </div>

            </div>


            <!-- =========================上传========================= -->

            <div class="speed-card">

                <div>

                    <div class="speed-card-label">
                        开始
                    </div>

                    <div class="speed-value"
                         id="uploadValue">
                        --
                    </div>

                    <div class="speed-unit">
                        Mbps
                    </div>

                </div>


                <div>

                    <div class="speed-progress">

                        <div
                            class="speed-progress-bar"
                            id="uploadProgress">
                        </div>

                    </div>

                    <button
                        class="speed-button"
                        id="uploadButton"
                        onclick="testUpload()">

                        TEST UPLOAD

                    </button>

                </div>

            </div>

        </div>


        <!-- =========================网络信息========================= -->

        <div class="network-info">

            <div class="info-card">

                <div class="info-label">
                    延迟
                </div>

                <div class="info-value">
                    <span id="latencyValue">--</span>
                    <span class="info-unit">ms</span>
                </div>

            </div>


            <div class="info-card">

                <div class="info-label">
                    抖动
                </div>

                <div class="info-value">
                    <span id="jitterValue">--</span>
                    <span class="info-unit">ms</span>
                </div>

            </div>


            <div class="info-card">

                <div class="info-label">
                    CLOUDFLARE EDGE
                </div>

                <div class="info-value"
                     id="edgeValue">

                    CLOUDFLARE

                </div>

            </div>

        </div>


        <div
            class="speed-status"
            id="speedStatus">

            READY // SELECT A TEST

        </div>

    </div>

</section>


<!-- =========================页脚========================= -->

<footer>

    <div>
        Jerry // Personal system
    </div>

    <div>
        Powered by Cloudflare
    </div>

</footer>


<!-- =========================鼠标光晕========================= -->

<script>

const glow =
    document.getElementById("glow");


document.addEventListener(
    "mousemove",
    (event) => {

        glow.style.left =
            event.clientX + "px";

        glow.style.top =
            event.clientY + "px";

    }
);


/* ============================================================
   PING TEST
   ============================================================ */

async function testPing() {

    const samples = [];

    for (
        let i = 0;
        i < 5;
        i++
    ) {

        const start =
            performance.now();

        try {

            await fetch(
                "/api/speed/ping?x=" +
                Math.random(),
                {
                    cache: "no-store"
                }
            );

            const latency =
                performance.now() - start;

            samples.push(latency);

        } catch {

            return;

        }

    }


    if (!samples.length) return;


    const average =
        samples.reduce(
            (a,b) => a + b,
            0
        ) / samples.length;


    let jitter = 0;


    if (samples.length > 1) {

        let differences = 0;

        for (
            let i = 1;
            i < samples.length;
            i++
        ) {

            differences +=
                Math.abs(
                    samples[i] -
                    samples[i - 1]
                );

        }

        jitter =
            differences /
            (samples.length - 1);
    }


    document.getElementById(
        "latencyValue"
    ).textContent =
        Math.round(average);


    document.getElementById(
        "jitterValue"
    ).textContent =
        Math.round(jitter);
}


/* ============================================================
   DOWNLOAD TEST
   ============================================================ */

async function testDownload() {

    const button =
        document.getElementById(
            "downloadButton"
        );

    const value =
        document.getElementById(
            "downloadValue"
        );

    const progress =
        document.getElementById(
            "downloadProgress"
        );

    const status =
        document.getElementById(
            "speedStatus"
        );


    button.disabled = true;

    button.textContent =
        "TESTING...";


    value.textContent =
        "0.0";

    progress.style.width =
        "0%";


    status.textContent =
        "DOWNLOAD // INITIALIZING";


    const controller =
        new AbortController();


    const start =
        performance.now();


    let bytes = 0;

    let response;


    try {

        response = await fetch(
            "/api/speed/download?x=" +
            Date.now(),
            {
                cache: "no-store",
                signal:
                    controller.signal
            }
        );


        if (!response.ok) {
            throw new Error(
                "Download API error"
            );
        }


        const reader =
            response.body.getReader();


        const endTime =
            start + 10000;


        while (performance.now() < endTime) {

            const remaining =
                endTime -
                performance.now();


            const result =
                await Promise.race([

                    reader.read(),

                    new Promise(
                        resolve =>
                            setTimeout(
                                () =>
                                    resolve({
                                        timeout: true
                                    }),
                                Math.max(
                                    remaining,
                                    1
                                )
                            )
                    )

                ]);


            if (result.timeout) {
                break;
            }


            if (result.done) {
                break;
            }


            bytes +=
                result.value.byteLength;


            const elapsed =
                (performance.now() -
                start) / 1000;


            if (elapsed > 0) {

                const mbps =
                    bytes * 8 /
                    elapsed /
                    1000000;


                value.textContent =
                    mbps.toFixed(1);

                status.textContent =
                    "DOWNLOAD // " +
                    mbps.toFixed(1) +
                    " Mbps";
            }

        }


    } catch (error) {

        if (
            error.name !==
            "AbortError"
        ) {

            status.textContent =
                "DOWNLOAD // ERROR";

            console.error(error);
        }

    }


    try {
        controller.abort();
    } catch {}


    const elapsed =
        (performance.now() -
        start) / 1000;


    if (bytes > 0 && elapsed > 0) {

        const mbps =
            bytes * 8 /
            elapsed /
            1000000;


        value.textContent =
            mbps.toFixed(1);


        progress.style.width =
            "100%";


        status.textContent =
            "DOWNLOAD // COMPLETE // " +
            mbps.toFixed(1) +
            " Mbps";
    }


    button.disabled = false;

    button.textContent =
        "TEST DOWNLOAD";


    await testPing();
}


/* ============================================================
   UPLOAD TEST
   ============================================================ */

async function testUpload() {

    const button =
        document.getElementById(
            "uploadButton"
        );

    const value =
        document.getElementById(
            "uploadValue"
        );

    const progress =
        document.getElementById(
            "uploadProgress"
        );

    const status =
        document.getElementById(
            "speedStatus"
        );


    button.disabled = true;

    button.textContent =
        "TESTING...";


    value.textContent =
        "0.0";

    progress.style.width =
        "0%";


    status.textContent =
        "UPLOAD // INITIALIZING";


    const controller =
        new AbortController();


    let bytesSent = 0;

    const start =
        performance.now();


    /*
     * 256 KB 数据块
     */

    const CHUNK_SIZE =
        256 * 1024;


    const chunk =
        new Uint8Array(
            CHUNK_SIZE
        );


    let running = true;


    const stream =
        new ReadableStream({

            pull(controller) {

                if (!running) {

                    controller.close();

                    return;
                }


                controller.enqueue(
                    chunk
                );


                bytesSent +=
                    chunk.byteLength;
            },

            cancel() {

                running = false;
            }

        });


    try {

        const uploadPromise =
            fetch(
                "/api/speed/upload",
                {
                    method: "POST",

                    body: stream,

                    duplex: "half",

                    signal:
                        controller.signal,

                    headers: {
                        "Content-Type":
                            "application/octet-stream",

                        "Cache-Control":
                            "no-cache"
                    }
                }
            );


        /*
         * 运行 10 秒
         */

        while (
            performance.now() -
            start <
            10000
        ) {

            const elapsed =
                (performance.now() -
                start) / 1000;


            if (elapsed > 0) {

                const mbps =
                    bytesSent * 8 /
                    elapsed /
                    1000000;


                value.textContent =
                    mbps.toFixed(1);


                status.textContent =
                    "UPLOAD // " +
                    mbps.toFixed(1) +
                    " Mbps";
            }


            await new Promise(
                resolve =>
                    setTimeout(
                        resolve,
                        100
                    )
            );
        }


        running = false;


        controller.abort();


        try {
            await uploadPromise;
        } catch {}


    } catch (error) {

        if (
            error.name !==
            "AbortError"
        ) {

            console.error(error);

            status.textContent =
                "UPLOAD // ERROR";
        }

    }


    const elapsed =
        (performance.now() -
        start) / 1000;


    if (
        bytesSent > 0 &&
        elapsed > 0
    ) {

        const mbps =
            bytesSent * 8 /
            elapsed /
            1000000;


        value.textContent =
            mbps.toFixed(1);


        progress.style.width =
            "100%";


        status.textContent =
            "UPLOAD // COMPLETE // " +
            mbps.toFixed(1) +
            " Mbps";
    }


    button.disabled = false;

    button.textContent =
        "TEST UPLOAD";


    await testPing();
}


/* ============================================================
   页面加载后自动测试 Ping
   ============================================================ */

window.addEventListener(
    "load",
    () => {

        testPing();

    }
);

</script>

</body>
</html>
